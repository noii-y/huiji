#!/usr/bin/env bash
# 推之前跑全 workspace 测试（提交时不跑，太慢）；跳过：git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# 与 pre-commit 同一套平台划分（理由见那边）：非 Apple 平台编不了依赖 objc2 的 IMK 壳。
case "$(uname -s)" in
  Darwin)
    test_scope=(--workspace)
    ;;
  MINGW*|MSYS*|CYGWIN*)
    # Server 的 build.rs 会嵌 uiAccess manifest，嵌了它的测试二进制没签名起不来（os error 740）；
    # 与 ci.yml 的 windows job 一样关掉。
    # 另排除 linux-server：它的 tests/vocabulary 集成测试（Alt+1 译词快捷键）在 Windows 跑不过，
    # CI 的 windows job 本就只测 server / tsf / settings，linux 逻辑交给 core job 在 Ubuntu 上验。
    test_scope=(--workspace --exclude qingjian-macos --exclude qingjian-linux-server)
    export QINGJIAN_UIACCESS=0
    ;;
  *)
    test_scope=(--workspace --exclude qingjian-macos)
    ;;
esac
cargo test "${test_scope[@]}" --locked
